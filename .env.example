# AirAware AI Environment Configuration

# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Google Gemini API Key (Backend only - never exposed to frontend)
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (Optional for demo mode; required for persistent cloud auth & DB)
# https://supabase.com/
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Environment & Demo settings
NODE_ENV=development
DEMO_MODE=true
